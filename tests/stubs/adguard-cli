#!/usr/bin/env bash
# Stub AdGuard CLI. State lives in files under $STUB_STATE so an action genuinely changes
# what the next read returns. STUB_REFUSE=1 makes every write a silent no-op, which is how
# the real adguard-cli behaves when it refuses a request and still exits 0.
set -uo pipefail

state=${STUB_STATE:?STUB_STATE must be set}

# STUB_FAIL=1 makes every query exit non-zero, the shape a broken or unreachable CLI takes.
if [[ ${STUB_FAIL:-0} == "1" ]]; then
  echo "cannot connect to the AdGuard daemon" >&2
  exit 1
fi
running_file="$state/running"
https_file="$state/https"
filters_file="$state/filters"

writes_allowed() {
  [[ ${STUB_REFUSE:-0} != "1" ]]
}

render_filters() {
  local id title enabled category mark stamp shown=""
  printf '    |           ID | Title                                   Last update        \n'
  while IFS='|' read -r id title enabled category; do
    [[ -n $id ]] || continue
    [[ -n $category ]] || category="Ad blocking"
    if [[ $category != "$shown" ]]; then
      printf '%s\n' "$category"
      shown=$category
    fi
    if [[ $enabled == "true" ]]; then
      mark="x"
      stamp="2026-08-23 19:06:48"
    else
      mark=" "
      stamp="Filter is disabled"
    fi
    # STUB_CTRL=1 puts a bare non-SGR escape in the title, which strip_ansi does not remove.
    [[ ${STUB_CTRL:-0} == "1" ]] && title=$(printf 'Bad\x1b[2K%s' "$title")
    printf '[%s] | %12s | %-39s %s \n' "$mark" "$id" "$title" "$stamp"
  done <"$filters_file"
  printf 'To view the full list of available filters, please run `adguard-cli filters list --all`\n'
}

set_filter() {
  local target=$1 want=$2 id title enabled out=""
  writes_allowed || return 0
  while IFS='|' read -r id title enabled; do
    [[ -n $id ]] || continue
    [[ $id == "$target" ]] && enabled=$want
    out+="${id}|${title}|${enabled}"$'\n'
  done <"$filters_file"
  printf '%s' "$out" >"$filters_file"
}

case "${1:-}" in
status)
  if [[ $(cat "$running_file") == "true" ]]; then
    printf 'The AdGuard proxy server is running\n'
  else
    printf 'The AdGuard proxy server is not running\n'
  fi
  ;;
start)
  writes_allowed && printf 'true' >"$running_file"
  printf 'The AdGuard proxy server has started successfully\n'
  ;;
stop)
  writes_allowed && printf 'false' >"$running_file"
  printf 'The AdGuard proxy server successfully stopped\n'
  ;;
config)
  case "${2:-}" in
  get) printf '%s = %s\n' "${3:-}" "$(cat "$https_file")" ;;
  set) writes_allowed && printf '%s' "${4:-}" >"$https_file" ;;
  esac
  ;;
filters)
  case "${2:-}" in
  list) render_filters ;;
  enable) set_filter "${3:-}" true ;;
  disable) set_filter "${3:-}" false ;;
  esac
  ;;
check-update)
  # STUB_UPDATED=1 makes check-update report a real refresh instead of a no-op.
  printf 'Checking filters updates...\n'
  if [[ ${STUB_UPDATED:-0} == "1" ]]; then
    printf 'Up to date\nChecking DNS filters updates...\n1 DNS filter(s) updated\n'
  elif [[ ${STUB_UPDATED_ZERO:-0} == "1" ]]; then
    printf 'Up to date\n0 filter(s) updated\nChecking SafebrowsingV2 updates...\nUpdated\n'
  else
    printf 'Up to date\n'
  fi
  ;;
esac

# The real binary exits 0 even when it refuses the request, which is the whole point.
exit 0
