#!/bin/bash
# Prints one JSON object for the omarchy-adguard bar widget and always exits 0.

set -uo pipefail

readonly ADGUARD_DATA_DIR="${HOME}/.local/share/adguard-cli"
readonly ACCESS_LOG="${ADGUARD_DATA_DIR}/logs/access.log"
readonly RUNNING_MARKER="The AdGuard proxy server is running"
# tailscale prints "; exit node;" only while routing through one; idle peers say "; offers exit node;".
readonly EXIT_NODE_MARKER="; exit node;"
readonly ERROR_MAX_CHARS=140
# check-update is network-bound, and a stall would leave the panel's spinner up for good.
readonly UPDATE_TIMEOUT_SEC=90
# A wedged daemon must not hold a local read open, or the run emits no JSON at all.
readonly READ_TIMEOUT_SEC=15

installed=false
running=false
https_filtering=false
blocked_today=0
exit_node_active=false
error=""
update_summary=""
last_update_ts=0
filters_json="[]"
# Blocks attributed to each filter today, "|2:11|3:169|".
filter_blocks="|"

want_kind=""
want_value=""

# Output of the last adguard-cli call, ANSI stripped.
cli_out=""

strip_ansi() {
  sed 's/\x1b\[[0-9;]*m//g'
}

# A title comes from a remote list, and one control byte would make the document unparseable.
json_string() {
  local s=${1//[[:cntrl:]]/}
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '"%s"' "$s"
}

note_error() {
  [[ -z $error ]] && error=${1:0:ERROR_MAX_CHARS}
  return 0
}

# A failed call is reported, never folded into a zero the panel would present as fact.
run_cli() {
  local raw rc
  raw=$(timeout "$READ_TIMEOUT_SEC" adguard-cli "$@" 2>/dev/null)
  rc=$?
  cli_out=$(printf '%s' "$raw" | strip_ansi)
  return "$rc"
}

read_installed() {
  command -v adguard-cli >/dev/null 2>&1 && installed=true
}

read_running() {
  if ! run_cli status; then
    note_error "adguard-cli status failed."
    return 0
  fi
  case "$cli_out" in
  *"$RUNNING_MARKER"*) running=true ;;
  *) running=false ;;
  esac
}

# sample: https_filtering.enabled = true
read_https_filtering() {
  local value
  if ! run_cli config get https_filtering.enabled; then
    note_error "adguard-cli could not read the HTTPS filtering setting."
    return 0
  fi
  value=${cli_out%%$'\n'*}
  value=${value#*=}
  value=${value// /}
  [[ $value == "true" ]] && https_filtering=true
}

# sample: 23.08.2026 23:47:09 "slack" TLS - slackb.com - - any BLOCKED 1 ID=3 52.3.167.79:443 0b 2ms -- ||slackb.com^
read_blocks() {
  local today lines count id rc
  filter_blocks="|"
  blocked_today=0
  # The log does not exist until the proxy first runs, which is a real zero.
  [[ -e $ACCESS_LOG ]] || return 0
  if [[ ! -r $ACCESS_LOG ]]; then
    note_error "Could not read the AdGuard access log."
    return 0
  fi
  today=$(date +%d.%m.%Y)
  lines=$(grep "^${today}.*BLOCKED" "$ACCESS_LOG" 2>/dev/null)
  rc=$?
  # grep exits 1 for no matches, which is a real zero; anything above that is a read fault.
  if [[ $rc -gt 1 ]]; then
    note_error "Could not read the AdGuard access log."
    return 0
  fi
  [[ -n $lines ]] || return 0

  blocked_today=$(printf '%s\n' "$lines" | grep -c .)
  while read -r count id; do
    [[ $id =~ ^[0-9]+$ ]] || continue
    filter_blocks+="${id}:${count}|"
  done < <(printf '%s\n' "$lines" | grep -o "ID=[0-9]*" | cut -d= -f2 | sort | uniq -c)
}

blocks_for() {
  local rest=${filter_blocks#*"|${1}:"}
  if [[ $rest == "$filter_blocks" ]]; then
    printf '0'
  else
    printf '%s' "${rest%%|*}"
  fi
}

# sample: [x] |            2 | AdGuard Base filter                     2026-08-23 19:06:48
read_filters() {
  local line mark rest id title enabled category="" first=1 out="[" stamp epoch

  if ! run_cli filters list; then
    note_error "adguard-cli could not list the filters."
    return 0
  fi
  [[ -n $cli_out ]] || return 0

  while IFS= read -r line; do
    # A line with no checkbox is either the column header or the category heading its rows.
    case "$line" in
    "[x] |"* | "[ ] |"*) ;;
    *)
      case "$line" in
      *"|"* | "To view"*) ;;
      *) [[ -n ${line// /} ]] && category=$line ;;
      esac
      continue
      ;;
    esac

    mark=${line:1:1}
    if [[ $mark == "x" ]]; then enabled=true; else enabled=false; fi

    rest=${line#*|}
    id=${rest%%|*}
    id=${id// /}
    [[ $id =~ ^[0-9]+$ ]] || continue

    title=${rest#*|}
    stamp=""
    # The last column is a refresh timestamp on an enabled filter and a note on a disabled one.
    if [[ $title =~ ^(.*[^[:space:]])[[:space:]][[:space:]]+([0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}:[0-9]{2}|Filter\ is\ .*)[[:space:]]*$ ]]; then
      title=${BASH_REMATCH[1]}
      stamp=${BASH_REMATCH[2]}
    fi
    # read trims leading and trailing whitespace on its own, so no sed is needed for it.
    read -r title <<<"$title"
    [[ -n $title ]] || continue

    if [[ $stamp =~ ^[0-9]{4}- ]]; then
      epoch=$(date -d "$stamp" +%s 2>/dev/null)
      [[ $epoch =~ ^[0-9]+$ ]] && ((epoch > last_update_ts)) && last_update_ts=$epoch
    fi

    [[ $first -eq 1 ]] || out+=","
    first=0
    out+="{\"id\":${id},\"title\":$(json_string "$title"),\"enabled\":${enabled}"
    out+=",\"category\":$(json_string "$category"),\"blocked\":$(blocks_for "$id")}"
  done <<<"$cli_out"

  out+="]"
  filters_json=$out
}

read_exit_node() {
  command -v tailscale >/dev/null 2>&1 || return 0
  local out
  out=$(tailscale status 2>/dev/null)
  case "$out" in
  *"$EXIT_NODE_MARKER"*) exit_node_active=true ;;
  esac
}

read_status() {
  read_running
  read_https_filtering
  read_blocks
  read_filters
  read_exit_node
}

# sample: Checking filters updates...\nUp to date\nChecking DNS filters updates...\n1 DNS filter(s) updated
summarise_update() {
  local line refreshed=0 unchanged=0
  while IFS= read -r line; do
    # A bare "Updated" is printed every run by SafebrowsingV2 and CRLite, so it proves nothing.
    if [[ $line =~ ^[1-9][0-9]*[[:space:]] && $line == *updated* ]]; then
      refreshed=1
    elif [[ $line == "Up to date" ]]; then
      unchanged=1
    fi
  done <<<"$1"

  if [[ $refreshed -eq 1 ]]; then
    printf 'Filters updated'
  elif [[ $unchanged -eq 1 ]]; then
    printf 'Everything is already up to date'
  else
    # Output this version does not recognise, so it reports the run rather than its outcome.
    printf 'Filters checked'
  fi
}

cmd_update() {
  local raw rc
  raw=$(timeout "$UPDATE_TIMEOUT_SEC" adguard-cli check-update 2>/dev/null)
  rc=$?
  if [[ $rc -ne 0 ]]; then
    note_error "Could not check for filter updates."
    return 0
  fi
  update_summary=$(summarise_update "$(printf '%s' "$raw" | strip_ansi)")
}

# adguard-cli exits 0 when it refuses, so intent is checked against the state observed after.
verify_intent() {
  case "$want_kind" in
  protection)
    if [[ $want_value == "on" && $running != true ]]; then
      note_error "Could not start AdGuard filtering."
    elif [[ $want_value == "off" && $running != false ]]; then
      note_error "Could not stop AdGuard filtering."
    fi
    ;;
  esac
}

emit() {
  printf '{"ok":%s,"installed":%s,"running":%s,"httpsFiltering":%s,"blockedToday":%s,"filters":%s,"exitNodeActive":%s,"updateSummary":%s,"lastUpdateTs":%s,"error":%s}\n' \
    "$([[ -z $error ]] && echo true || echo false)" \
    "$installed" "$running" "$https_filtering" "$blocked_today" \
    "$filters_json" "$exit_node_active" "$(json_string "$update_summary")" \
    "$last_update_ts" "$(json_string "$error")"
}

cmd_protection() {
  want_kind="protection"
  want_value=${1:-}
  case "$want_value" in
  on) adguard-cli start >/dev/null 2>&1 ;;
  off) adguard-cli stop >/dev/null 2>&1 ;;
  *)
    want_kind=""
    note_error "Unknown protection argument."
    ;;
  esac
}

main() {
  local command=${1:-status}
  shift || true

  read_installed
  if [[ $installed != true ]]; then
    note_error "AdGuard is not installed."
    emit
    return 0
  fi

  case "$command" in
  status) ;;
  protection) cmd_protection "${1:-}" ;;
  # adguard-cli merged "filters update" into check-update.
  update) cmd_update ;;
  *) note_error "Unknown command." ;;
  esac

  read_status
  verify_intent
  emit
}

main "$@"
