#!/bin/bash
# Reads and controls AdGuard for Linux for the omarchy-adguard bar widget.
# Prints one JSON object on stdout and always exits 0, so the panel can always render.

set -uo pipefail

readonly ADGUARD_DATA_DIR="${HOME}/.local/share/adguard-cli"
readonly ACCESS_LOG="${ADGUARD_DATA_DIR}/logs/access.log"
readonly RUNNING_MARKER="The AdGuard proxy server is running"
# tailscale prints "; exit node;" only while routing through one; idle peers say "; offers exit node;".
readonly EXIT_NODE_MARKER="; exit node;"
readonly ERROR_MAX_CHARS=140

installed=false
running=false
https_filtering=false
blocked_today=0
exit_node_active=false
error=""
update_summary=""
# Epoch of the most recent filter refresh, which is what "when did we last check" means.
last_update_ts=0
filters_json="[]"
# Blocks attributed to each filter today, same shape: "|2:11|3:169|".
filter_blocks="|"

# What the caller asked for, checked against reality after the write lands.
want_kind=""
want_value=""

strip_ansi() {
  sed 's/\x1b\[[0-9;]*m//g'
}

json_string() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\t'/ }
  s=${s//$'\n'/ }
  s=${s//$'\r'/ }
  printf '"%s"' "$s"
}

note_error() {
  [[ -z $error ]] && error=${1:0:ERROR_MAX_CHARS}
  return 0
}

read_installed() {
  command -v adguard-cli >/dev/null 2>&1 && installed=true
}

read_running() {
  local out
  out=$(adguard-cli status 2>/dev/null | strip_ansi)
  case "$out" in
  *"$RUNNING_MARKER"*) running=true ;;
  *) running=false ;;
  esac
}

# sample: https_filtering.enabled = true
read_https_filtering() {
  local out value
  out=$(adguard-cli config get https_filtering.enabled 2>/dev/null | strip_ansi | head -1)
  value=${out#*=}
  value=${value// /}
  [[ $value == "true" ]] && https_filtering=true
}

# sample: 23.08.2026 19:56:36.991713 "curl" TLS - securepubads.g.doubleclick.net - - any BLOCKED 1 ID=2 ...
read_blocked_today() {
  local today count
  [[ -r $ACCESS_LOG ]] || return 0
  today=$(date +%d.%m.%Y)
  # grep exits 1 when nothing matches, which is a legitimate zero rather than a failure.
  count=$(grep -c "^${today}.*BLOCKED" "$ACCESS_LOG" 2>/dev/null)
  [[ $count =~ ^[0-9]+$ ]] && blocked_today=$count
}

# Every BLOCKED line names the filter that matched, so the tally is exact rather than shared out.
# sample: 23.08.2026 23:47:09 "slack" TLS - slackb.com - - any BLOCKED 1 ID=3 52.3.167.79:443 0b 2ms -- ||slackb.com^
read_filter_blocks() {
  local today line id count
  filter_blocks="|"
  [[ -r $ACCESS_LOG ]] || return 0
  today=$(date +%d.%m.%Y)
  while read -r count id; do
    [[ $id =~ ^[0-9]+$ ]] || continue
    filter_blocks+="${id}:${count}|"
  done < <(grep "^${today}.*BLOCKED" "$ACCESS_LOG" 2>/dev/null |
    grep -o "ID=[0-9]*" | cut -d= -f2 | sort | uniq -c)
}

blocks_for() {
  local rest=${filter_blocks#*"|${1}:"}
  if [[ $rest == "$filter_blocks" ]]; then
    printf '0'
  else
    printf '%s' "${rest%%|*}"
  fi
}

# sample: [x] |            2 | AdGuard Base filter                     2026-08-23 19:06:48
# sample: [ ] |            4 | AdGuard Social Media filter             Filter is disabled
read_filters() {
  local raw line mark rest id title enabled category="" first=1 out="[" stamp epoch

  raw=$(adguard-cli filters list 2>/dev/null | strip_ansi)
  [[ -n $raw ]] || return 0

  while IFS= read -r line; do
    # A line with no checkbox is either the column header or the category the rows below belong to.
    case "$line" in
    "[x] |"* | "[ ] |"*) ;;
    *)
      case "$line" in
      *"|"* | "To view"*) ;;
      *) [[ -n ${line// /} ]] && category=$line ;;
      esac
      continue
      ;;
    esac

    mark=${line:1:1}
    if [[ $mark == "x" ]]; then enabled=true; else enabled=false; fi

    rest=${line#*|}
    id=${rest%%|*}
    id=${id// /}
    [[ $id =~ ^[0-9]+$ ]] || continue

    title=${rest#*|}
    # A refreshed filter carries its timestamp in the last column; a disabled one carries a
    # note instead, so only the former can move the clock.
    stamp=$(printf '%s' "$title" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}[[:space:]]*$')
    if [[ -n $stamp ]]; then
      epoch=$(date -d "$stamp" +%s 2>/dev/null)
      [[ $epoch =~ ^[0-9]+$ ]] && ((epoch > last_update_ts)) && last_update_ts=$epoch
    fi
    # The last column is either a timestamp or a "Filter is ..." note; both follow a run of spaces.
    title=$(printf '%s' "$title" | sed -E 's/[[:space:]]{2,}([0-9]{4}-[0-9]{2}-[0-9]{2} [0-9:]+|Filter is .*)[[:space:]]*$//')
    title=$(printf '%s' "$title" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')
    [[ -n $title ]] || continue

    [[ $first -eq 1 ]] || out+=","
    first=0
    out+="{\"id\":${id},\"title\":$(json_string "$title"),\"enabled\":${enabled}"
    out+=",\"category\":$(json_string "$category"),\"blocked\":$(blocks_for "$id")}"
  done <<<"$raw"

  out+="]"
  filters_json=$out
}

# sample: Checking filters updates... / Up to date / 1 DNS filter(s) updated / Updated
summarise_update() {
  local out=$1 changed
  changed=$(printf '%s' "$out" | grep -ci "updated")
  if [[ $changed -eq 0 ]]; then
    printf 'Everything is already up to date'
  else
    printf 'Filters updated'
  fi
}

cmd_update() {
  local out
  out=$(adguard-cli check-update 2>&1 | strip_ansi)
  update_summary=$(summarise_update "$out")
}

read_exit_node() {
  command -v tailscale >/dev/null 2>&1 || return 0
  local out
  out=$(tailscale status 2>/dev/null)
  case "$out" in
  *"$EXIT_NODE_MARKER"*) exit_node_active=true ;;
  esac
}

read_status() {
  read_running
  read_https_filtering
  read_blocked_today
  read_filter_blocks
  read_filters
  read_exit_node
}


# adguard-cli exits 0 even when it refuses the request, so intent is checked against
# the state actually observed afterwards rather than against any exit code or message.
verify_intent() {
  case "$want_kind" in
  protection)
    if [[ $want_value == "on" && $running != true ]]; then
      note_error "Could not start AdGuard filtering."
    elif [[ $want_value == "off" && $running != false ]]; then
      note_error "Could not stop AdGuard filtering."
    fi
    ;;
  esac
}

emit() {
  printf '{"ok":%s,"installed":%s,"running":%s,"httpsFiltering":%s,"blockedToday":%s,"filters":%s,"exitNodeActive":%s,"updateSummary":%s,"lastUpdateTs":%s,"error":%s}\n' \
    "$([[ -z $error ]] && echo true || echo false)" \
    "$installed" "$running" "$https_filtering" "$blocked_today" \
    "$filters_json" "$exit_node_active" "$(json_string "$update_summary")" \
    "$last_update_ts" "$(json_string "$error")"
}

cmd_protection() {
  want_kind="protection"
  want_value=${1:-}
  case "$want_value" in
  on) adguard-cli start >/dev/null 2>&1 ;;
  off) adguard-cli stop >/dev/null 2>&1 ;;
  *)
    want_kind=""
    note_error "Unknown protection argument."
    ;;
  esac
}



main() {
  local command=${1:-status}
  shift || true

  read_installed
  if [[ $installed != true ]]; then
    note_error "AdGuard is not installed."
    emit
    return 0
  fi

  case "$command" in
  status) ;;
  protection) cmd_protection "${1:-}" ;;
  # adguard-cli merged "filters update" into check-update.
  update) cmd_update ;;
  *) note_error "Unknown command." ;;
  esac

  read_status
  verify_intent
  emit
}

main "$@"
